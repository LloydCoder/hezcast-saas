# ═══════════════════════════════════════════════════════
# HezCast SaaS — Environment Variables
# Copy to .env.local and fill in your values
# NEVER commit .env.local to git
# ═══════════════════════════════════════════════════════

# ── Clerk Auth ─────────────────────────────────────────
# Get from clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── HezCast API ────────────────────────────────────────
# Your FastAPI backend (VPS or localhost)
NEXT_PUBLIC_API_URL=http://localhost:8503

# ── LemonSqueezy ───────────────────────────────────────
# For pricing page buy buttons
NEXT_PUBLIC_LS_STORE_URL=https://hezcast.lemonsqueezy.com
NEXT_PUBLIC_LS_STARTER_URL=https://hezcast.lemonsqueezy.com/checkout/buy/starter
NEXT_PUBLIC_LS_PRO_URL=https://hezcast.lemonsqueezy.com/checkout/buy/pro
NEXT_PUBLIC_LS_AGENCY_URL=https://hezcast.lemonsqueezy.com/checkout/buy/agency

# ── App Config ─────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=HezCast
NEXT_PUBLIC_APP_URL=https://cast.tinlance.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/Tinlance/hezcast-engine
